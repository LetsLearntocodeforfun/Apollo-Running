{
  "name": "apollo-marathon",
  "version": "1.0.9",
  "description": "Apollo — free, local-first marathon training: proven plans, race-day planning and coaching insights. Your data stays on your device.",
  "author": {
    "name": "LetsLearntocodeforfun",
    "email": "apollo-running@users.noreply.github.com"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite --config vite.config.web.ts",
    "dev:electron": "vite --config vite.config.ts",
    "build": "npm run build:electron",
    "build:web": "vite build --config vite.config.web.ts",
    "build:electron": "vite build --config vite.config.ts",
    "build:pages": "cross-env APOLLO_BASE=/Apollo-Running/ vite build --config vite.config.web.ts",
    "check:bundle": "node scripts/check-bundle.mjs",
    "package": "npm run build:electron && electron-builder --publish never",
    "preview": "vite preview --config vite.config.web.ts",
    "preview:web": "vite preview --config vite.config.web.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . --max-warnings=34",
    "format": "prettier --write \"{src,electron,e2e,scripts}/**/*.{ts,tsx,js,mjs,cjs,css,json}\" \"*.{ts,mjs,cjs,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:tz": "cross-env TZ=America/Los_Angeles vitest run && cross-env TZ=Europe/London vitest run && cross-env TZ=Australia/Sydney vitest run",
    "test:e2e": "npm run build:electron && playwright test",
    "test:e2e:only": "playwright test",
    "electron:dev": "npm run dev:electron",
    "electron:build": "npm run package",
    "swa": "swa start ./dist --api-location ./api",
    "format:check": "prettier --check \"{src,electron,e2e,scripts}/**/*.{ts,tsx,js,mjs,cjs,css,json}\" \"*.{ts,mjs,cjs,json}\""
  },
  "dependencies": {
    "dexie": "^4.0.9",
    "electron-updater": "^6.8.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/inter": "^5.2.6",
    "@fontsource-variable/montserrat": "^5.2.6",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "electron": "^44.9.1",
    "electron-builder": "^26.9.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "fake-indexeddb": "^6.0.1",
    "globals": "^16.5.0",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.8",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.7",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.11",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.apollo.marathon",
    "productName": "Apollo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "!dist/assets/logo-1024.png",
      "!dist/staticwebapp.config.json"
    ],
    "icon": "public/assets/logo-1024.png",
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/assets/logo-1024.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.healthcare-fitness",
      "icon": "public/assets/logo-1024.png"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "public/assets/logo-1024.png"
    },
    "publish": {
      "provider": "github",
      "owner": "LetsLearntocodeforfun",
      "repo": "Apollo-Running"
    }
  }
}
